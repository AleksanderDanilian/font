{$DOMAIN} {
	encode gzip

	# Локальные фолбэк-шрифты (/static/fonts/...) не меняются задним числом —
	# один и тот же путь всегда отдаёт один и тот же файл (см. build_database.py:
	# при смене описания/эмбеддинга путь к файлу не трогается). Их безопасно
	# кэшировать агрессивно и надолго.
	#
	# ВАЖНО: остальную статику (frontend/*.html, *.css, *.js) так кэшировать
	# НЕЛЬЗЯ — у файлов нет версионируемых имён (style.css всегда style.css),
	# и agressive+immutable кэш означал бы, что после деплоя правок пользователи
	# с уже закэшированной страницей не увидят обновление без hard refresh.
	@fonts path /static/fonts/*
	header @fonts Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy app:8000
}