# --- Paths ---
# ВАЖНО: относительные пути ниже резолвятся не от cwd (директории, откуда
# запущена команда), а от корня проекта (папка, где лежит .env — уровнем
# выше backend/). Это значит, что и `python backend/build_database.py`
# из корня, и `cd backend && uvicorn main:app` одинаково найдут /data и
# /fonts, независимо от того, откуда вы стартуете процесс.
DATA_DIR=./data
FONTS_DIR=./fonts
FRONTEND_DIR=./frontend
DB_PATH=./backend/fonts.db
SYNONYMS_PATH=./data/synonyms.json
FONTS_FULL_MANIFEST_PATH=./data/fonts_full_manifest.jsonl
FONTS_LABELS_PATH=./data/fonts.jsonl

# --- Embedding model ---
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# --- Scoring weights (defaults, section 7.5 of TZ) ---
WEIGHT_TAGS=0.45
WEIGHT_EMBEDDING=0.45
WEIGHT_PREMIUM_BONUS=0.10

# --- Search cache ---
SEARCH_CACHE_TTL_SECONDS=900
SEARCH_PAGE_SIZE=10

# --- CORS ---
# Comma-separated list of allowed origins, or * for dev
CORS_ORIGINS=*

# --- Static files ---
STATIC_FONTS_URL_PREFIX=/static/fonts

# --- Docker Compose (docker-compose.yml + docker/Caddyfile) ---
# Используется ТОЛЬКО docker-compose при подстановке ${DOMAIN} в Caddyfile —
# приложение само эту переменную не читает. Для локального запуска без
# Docker можно не указывать.
DOMAIN=fontasize.online

# Форс-пересчёт ВСЕХ эмбеддингов при следующей автосборке БД (см.
# entrypoint.sh) — поставьте =1 один раз при первом деплое после смены
# EMBEDDING_MODEL_NAME (у paraphrase-multilingual-MiniLM-L12-v2 та же
# размерность 384, что и у прежней all-MiniLM-L6-v2 — без этого флага
# build_database.py может молча оставить несовместимые старые векторы).
# После первого успешного билда на новой модели верните обратно на 0.
FORCE_RECOMPUTE_EMBEDDINGS=1

# Опционально: если хотите докачать метаданные Google Fonts или прогнать
# enrich_descriptions.py прямо на сервере — эти ключи тут не нужны для
# самого запуска приложения, но пригодятся для соответствующих скриптов
# (см. backend/fetch_google_fonts_metadata.py, backend/enrich_descriptions.py).
# GOOGLE_FONTS_API_KEY=
# ANTHROPIC_API_KEY=
